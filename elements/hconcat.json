{
  "schemaVersion": 1,
  "id": "hconcat",
  "name": "Horizontal Concat",
  "kind": "transform",
  "category": "utility",
  "icon": "transform",
  "summary": "Join img0 (left) and img1 (right). Heights, bit depth, and channel count must match. No resizing or conversion.",
  "inputs": [
    { "name": "img0", "type": "image" },
    { "name": "img1", "type": "image" }
  ],
  "outputs": [{ "name": "image", "type": "image" }],
  "params": {},
  "telemetry": [],
  "exec": {
    "cli": "cpp-image-effects/build/hconcat_cli",
    "args": ["{in.img0}", "{in.img1}", "{out.image}"]
  }
}
