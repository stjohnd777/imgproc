{
  "schemaVersion": 1,
  "id": "corners",
  "name": "Corners",
  "kind": "transform",
  "category": "feature",
  "icon": "transform",
  "summary": "Shi-Tomasi corner detector, up to 500 corners at least 10 px apart. Outputs keypoint JSON and an annotated preview image.",
  "inputs": [
    {
      "name": "image",
      "type": "image"
    }
  ],
  "outputs": [
    {
      "name": "preview",
      "type": "image"
    },
    {
      "name": "keypoints",
      "type": "keypoints"
    }
  ],
  "params": {
    "maxCorners": {
      "type": "number",
      "default": 500,
      "min": 1,
      "max": 100000,
      "step": 1
    },
    "qualityLevel": {
      "type": "number",
      "default": 0.01,
      "min": 1e-06,
      "max": 1,
      "step": 0.001,
      "description": "Fraction of the strongest corner a corner must reach."
    },
    "minDistance": {
      "type": "number",
      "default": 10,
      "min": 0,
      "max": 1000
    },
    "blockSize": {
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 31,
      "step": 1
    }
  },
  "telemetry": [],
  "exec": {
    "cli": "cpp-corners/build/corners_cli",
    "args": [
      "{in.image}",
      "{out.preview}",
      "{out.keypoints}",
      "{param.maxCorners}",
      "{param.qualityLevel}",
      "{param.minDistance}",
      "{param.blockSize}"
    ]
  }
}
