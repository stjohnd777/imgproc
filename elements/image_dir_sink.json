{
  "schemaVersion": 1,
  "id": "image_dir_sink",
  "name": "Save to Directory",
  "kind": "sink",
  "icon": "storage",
  "summary": "Writes each incoming image to a directory.",
  "inputs": [
    { "name": "image", "type": "image" }
  ],
  "outputs": [],
  "params": {
    "dir": {
      "type": "folder",
      "label": "Destination folder",
      "default": null,
      "create": true,
      "description": "Results are written here. A new folder can be created from the chooser."
    },
    "fmt": { "type": "enum", "label": "File format", "default": "png", "values": ["png", "jpg", "bmp", "webp"] }
  },
  "telemetry": [],
  "exec": { "builtin": "save_to_dir" }
}