{
  "schemaVersion": 1,
  "id": "sift",
  "name": "SIFT",
  "kind": "transform",
  "category": "feature",
  "icon": "transform",
  "summary": "SIFT keypoint detector. Outputs the keypoints and an annotated preview image.",
  "inputs": [
    {
      "name": "image",
      "type": "image"
    }
  ],
  "outputs": [
    {
      "name": "keypoints",
      "type": "keypoints"
    },
    {
      "name": "preview",
      "type": "image"
    }
  ],
  "params": {
    "nfeatures": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 100000,
      "step": 1,
      "description": "0 keeps every keypoint."
    },
    "nOctaveLayers": {
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 8,
      "step": 1
    },
    "contrastThreshold": {
      "type": "number",
      "default": 0.04,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "edgeThreshold": {
      "type": "number",
      "default": 10,
      "min": 0,
      "max": 100
    },
    "sigma": {
      "type": "number",
      "default": 1.6,
      "min": 0.1,
      "max": 10,
      "step": 0.1
    }
  },
  "telemetry": [],
  "exec": {
    "cli": "cpp-sift/build/sift_cli",
    "args": [
      "{in.image}",
      "{out.preview}",
      "{out.keypoints}",
      "{param.nfeatures}",
      "{param.nOctaveLayers}",
      "{param.contrastThreshold}",
      "{param.edgeThreshold}",
      "{param.sigma}"
    ]
  }
}
