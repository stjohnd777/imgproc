{
  "schemaVersion": 1,
  "id": "brisk",
  "name": "BRISK",
  "kind": "transform",
  "category": "feature",
  "icon": "transform",
  "summary": "BRISK keypoint detector. Outputs keypoint JSON and an annotated preview image.",
  "inputs": [
    {
      "name": "image",
      "type": "image"
    }
  ],
  "outputs": [
    {
      "name": "preview",
      "type": "image"
    },
    {
      "name": "keypoints",
      "type": "keypoints"
    }
  ],
  "params": {
    "thresh": {
      "type": "number",
      "default": 30,
      "min": 0,
      "max": 255,
      "step": 1
    },
    "octaves": {
      "type": "number",
      "default": 3,
      "min": 0,
      "max": 8,
      "step": 1
    },
    "patternScale": {
      "type": "number",
      "default": 1,
      "min": 0.1,
      "max": 10,
      "step": 0.1
    }
  },
  "telemetry": [],
  "exec": {
    "cli": "cpp-brisk/build/brisk_cli",
    "args": [
      "{in.image}",
      "{out.preview}",
      "{out.keypoints}",
      "{param.thresh}",
      "{param.octaves}",
      "{param.patternScale}"
    ]
  }
}
