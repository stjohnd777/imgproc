{
  "schemaVersion": 1,
  "id": "gaussian",
  "name": "Gaussian",
  "kind": "transform",
  "category": "enhancement",
  "icon": "transform",
  "summary": "Gaussian blur. A sigma of 0 is derived from the kernel size.",
  "inputs": [
    { "name": "image", "type": "image" }
  ],
  "outputs": [
    { "name": "image", "type": "image" }
  ],
  "params": {
    "ksize": { "type": "number", "default": 5, "min": 1, "max": 31, "step": 2, "description": "Odd kernel size." },
    "sigmaX": { "type": "number", "default": 0, "min": 0 },
    "sigmaY": { "type": "number", "default": 0, "min": 0 }
  },
  "telemetry": [],
  "exec": {
    "cli": "cpp-gaussian/build/gaussian_cli",
    "args": ["{in.image}", "{out.image}", "{param.ksize}", "{param.sigmaX}", "{param.sigmaY}"]
  }
}