{
  "schemaVersion": 1,
  "id": "surf",
  "name": "SURF",
  "kind": "transform",
  "category": "feature",
  "icon": "transform",
  "summary": "SURF keypoint detector. Needs OpenCV contrib built with OPENCV_ENABLE_NONFREE. Outputs keypoint JSON and an annotated preview image.",
  "inputs": [
    {
      "name": "image",
      "type": "image"
    }
  ],
  "outputs": [
    {
      "name": "preview",
      "type": "image"
    },
    {
      "name": "keypoints",
      "type": "keypoints"
    }
  ],
  "params": {
    "hessianThreshold": {
      "type": "number",
      "default": 400,
      "min": 1,
      "max": 50000,
      "description": "Higher finds fewer, stronger features."
    },
    "nOctaves": {
      "type": "number",
      "default": 4,
      "min": 1,
      "max": 8,
      "step": 1
    },
    "nOctaveLayers": {
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 8,
      "step": 1
    }
  },
  "telemetry": [],
  "exec": {
    "cli": "cpp-surf/build/surf_cli",
    "args": [
      "{in.image}",
      "{out.preview}",
      "{out.keypoints}",
      "{param.hessianThreshold}",
      "{param.nOctaves}",
      "{param.nOctaveLayers}"
    ]
  }
}
