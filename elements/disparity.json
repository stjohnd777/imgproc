{
  "schemaVersion": 1,
  "id": "disparity",
  "name": "Disparity",
  "kind": "transform",
  "category": "stereo",
  "icon": "transform",
  "summary": "Dense StereoSGBM disparity from already-rectified 8-bit left/right images. Outputs a visualization and numeric pixel disparities; does not rectify images or estimate metric depth.",
  "inputs": [
    { "name": "left", "type": "image" },
    { "name": "right", "type": "image" }
  ],
  "outputs": [
    { "name": "disparity", "type": "disparity" },
    { "name": "data", "type": "text" }
  ],
  "params": {
    "numDisparities": { "type": "integer", "label": "Disparity range (px, multiple of 16)", "default": 64, "min": 16, "max": 512, "step": 16, "description": "Search disparities from 0 to range - 1. Must be smaller than the image width." },
    "blockSize": { "type": "odd", "label": "Block size (px)", "default": 9, "min": 3, "max": 21, "step": 2 },
    "uniquenessRatio": { "type": "integer", "label": "Uniqueness ratio (%)", "default": 10, "min": 0, "max": 100, "step": 1 },
    "speckleWindowSize": { "type": "integer", "label": "Speckle window (pixels, 0 disables)", "default": 100, "min": 0, "max": 1000, "step": 1 },
    "speckleRange": { "type": "integer", "label": "Speckle disparity tolerance (px)", "default": 2, "min": 0, "max": 32, "step": 1 }
  },
  "telemetry": [],
  "exec": {
    "cli": "cpp-disparity/build/disparity_cli",
    "args": ["{in.left}", "{in.right}", "{out.disparity}", "{out.data}", "{param.numDisparities}", "{param.blockSize}", "{param.uniquenessRatio}", "{param.speckleWindowSize}", "{param.speckleRange}"]
  }
}