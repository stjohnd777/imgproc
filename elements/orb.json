{
  "schemaVersion": 1,
  "id": "orb",
  "name": "ORB",
  "kind": "transform",
  "category": "feature",
  "icon": "transform",
  "summary": "ORB keypoint detector, up to 1000 features. Outputs keypoint JSON and an annotated preview image.",
  "inputs": [
    {
      "name": "image",
      "type": "image"
    }
  ],
  "outputs": [
    {
      "name": "preview",
      "type": "image"
    },
    {
      "name": "keypoints",
      "type": "keypoints"
    }
  ],
  "params": {
    "nfeatures": {
      "type": "number",
      "default": 1000,
      "min": 1,
      "max": 100000,
      "step": 1
    },
    "scaleFactor": {
      "type": "number",
      "default": 1.2,
      "min": 1.01,
      "max": 4,
      "step": 0.01
    },
    "nlevels": {
      "type": "number",
      "default": 8,
      "min": 1,
      "max": 16,
      "step": 1
    },
    "fastThreshold": {
      "type": "number",
      "default": 20,
      "min": 0,
      "max": 255,
      "step": 1
    }
  },
  "telemetry": [],
  "exec": {
    "cli": "cpp-orb/build/orb_cli",
    "args": [
      "{in.image}",
      "{out.preview}",
      "{out.keypoints}",
      "{param.nfeatures}",
      "{param.scaleFactor}",
      "{param.nlevels}",
      "{param.fastThreshold}"
    ]
  }
}
