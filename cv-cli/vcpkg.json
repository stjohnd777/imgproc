{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "orbital-eyes-native",
  "version-string": "0.9.0",
  "description": "Native OpenCV command-line tools used by Orbital Eyes.",
  "builtin-baseline": "be1ae8e5c5bc79aac1b8f593f5554aee1cfde54f",
  "vcpkg-configuration": {
    "overlay-triplets": ["./triplets"]
  },
  "dependencies": [
    "nlohmann-json",
    {
      "name": "opencv4",
      "default-features": false,
      "features": [
        "calib3d",
        "fs",
        "intrinsics",
        "jpeg",
        "png",
        "thread",
        "tiff",
        "webp",
        { "name": "dshow", "platform": "windows" },
        { "name": "msmf", "platform": "windows" }
      ]
    }
  ]
}
