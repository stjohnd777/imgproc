{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "system",
      "displayName": "System packages (Homebrew, apt, ...)",
      "description": "Uses an OpenCV already installed on this machine; tools link it in place.",
      "binaryDir": "${sourceDir}/../build/native-system",
      "installDir": "${sourceDir}/../native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OE_BUNDLE_RUNTIME": "OFF"
      }
    },
    {
      "name": "vcpkg",
      "displayName": "vcpkg (portable, redistributable)",
      "description": "Builds OpenCV from cv-cli/vcpkg.json and bundles its shared libraries. Requires VCPKG_ROOT.",
      "binaryDir": "${sourceDir}/../build/native-vcpkg",
      "installDir": "${sourceDir}/../native",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OE_BUNDLE_RUNTIME": "ON",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
        "VCPKG_INSTALL_OPTIONS": "--clean-after-build"
      }
    }
  ],
  "buildPresets": [
    { "name": "system", "configurePreset": "system", "configuration": "Release" },
    { "name": "vcpkg", "configurePreset": "vcpkg", "configuration": "Release" }
  ]
}
